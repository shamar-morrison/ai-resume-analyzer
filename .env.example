# Clerk Authentication Keys
# Get these from: https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: Custom sign-in/sign-up URLs (for custom pages)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# MongoDB Configuration
# Get your MongoDB connection string from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=

# Clerk Webhook Secret
# Get this from: https://dashboard.clerk.com -> Webhooks -> Add Endpoint
CLERK_WEBHOOK_SECRET=

# Google Gemini API Key
# Get this from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
